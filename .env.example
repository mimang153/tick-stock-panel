# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest cache-redis
BACKEND_EXTRAS=

# ===== ClickHouse（存储层，见 docs/clickhouse-storage-design.md §4.8/§4.9）=====
# CK 由 docker compose 以 clickhouse/clickhouse-server:24.8.8-alpine 启动，
# 数据落在 ./data/clickhouse，库与账号由 deploy/clickhouse/init 预建。
#   docker compose up -d clickhouse            # 只起 CK
#   CLICKHOUSE_URL: 源码直跑用 http://localhost:8123；compose 内应用容器由
#   compose 自动改写为 http://clickhouse:8123，无需在此配置。
# 默认账号 tsp / tsp123456，修改后需与应用保持一致（同时供 CK 容器创建用户）。
# 宿主 8123 已被其它 ClickHouse 占用时，用 CLICKHOUSE_HTTP_PORT 改映射端口，
# 并把 CLICKHOUSE_URL 改成对应的 localhost 端口。
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=tsp
CLICKHOUSE_USER=tsp
CLICKHOUSE_PASSWORD=tsp123456

# ===== Cache Backend =====
# S4 起默认 redis（跨 worker 共享 + generation 计数器），BACKEND_EXTRAS 需含 cache-redis。
# 离线/单进程调试可改 memory；pytest 在 conftest 强制 memory 保证测试隔离。
# Redis 不由本项目 compose 创建：./redis-cache.sh up 用宿主机已有镜像幂等创建/启动容器。
# 源码直跑用 localhost；容器内由 CACHE_REDIS_URL_CONTAINER 注入 host.docker.internal。
# 密码含特殊字符时需做 URL 编码；无密码用 redis://localhost:6379/0。
CACHE_BACKEND=redis
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL_CONTAINER=redis://host.docker.internal:6379/0
CACHE_REDIS_PREFIX=tickflow:cache:
CACHE_REDIS_SOCKET_TIMEOUT_S=1.0
# 宿主机 Redis 容器配置（供 ./redis-cache.sh up/status/check 使用）
REDIS_CONTAINER=
REDIS_IMAGE=redis:8-alpine
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
# DES-006 D-02: 会话/任务热态不能被驱逐，实例级策略必须是 noeviction。
REDIS_MAXMEMORY_POLICY=noeviction

# ===== Multi-instance coordination / mining state =====
# S4 起默认 redis：SSE 跨进程广播、取消标志/限流/任务状态跨实例共享、
# mining run 用 Lua 状态机 + CK 审计，启动钩子经 coordination.once() 单飞。
# 离线/单进程调试可改 memory；pytest 在 conftest 强制 memory 保证测试隔离。
# URL 与宿主机 Redis 容器保持一致。
EVENT_BUS_BACKEND=redis
EVENT_BUS_REDIS_URL=redis://:123456@localhost:6379/0
EVENT_BUS_REDIS_URL_CONTAINER=redis://:123456@host.docker.internal:6379/0
EVENT_BUS_REDIS_CHANNEL=tickflow:events
EVENT_BUS_REDIS_SOCKET_TIMEOUT_S=1.0
COORDINATION_BACKEND=redis
COORDINATION_REDIS_URL=redis://:123456@localhost:6379/0
COORDINATION_REDIS_URL_CONTAINER=redis://:123456@host.docker.internal:6379/0
COORDINATION_REDIS_PREFIX=tickflow:coord:
COORDINATION_REDIS_SOCKET_TIMEOUT_S=1.0
MINING_STORE_BACKEND=redis
# 挖掘产物根：redis 后端必填。DES-006 默认 pgblob（内容存 PG，本地仅 staging）。
# shared-root 用 NFS/共享卷，s3 用兼容对象存储；下方 DES-006 段会覆盖为 pgblob。
MINING_ARTIFACT_ROOT=/app/data/.staging/mining-artifacts
MINING_ARTIFACT_STORE=pgblob
# MINING_ARTIFACT_STORE=s3 时必填：
MINING_ARTIFACT_S3_BUCKET=
MINING_ARTIFACT_S3_PREFIX=mining-artifacts
MINING_ARTIFACT_S3_ENDPOINT_URL=

# ===== PostgreSQL — 模拟盘账户事务层（DES-005）=====
# 由 ./pg_dev.sh 用宿主机已有镜像（postgres:14-alpine）幂等启动容器，数据落 tsp-pgdata 卷。
# 源码直跑用 localhost；容器内由 compose 注入 PAPER_PG_URL_CONTAINER（host.docker.internal）。
# 库/账号：tsp_dev / tsp / 123456（由 ./pg_dev.sh init 幂等创建）。
PAPER_PG_URL=postgresql://tsp:123456@localhost:5432/tsp_dev
PAPER_PG_URL_CONTAINER=postgresql://tsp:123456@host.docker.internal:5432/tsp_dev
PG_CONTAINER=tsp-pg-dev
PG_IMAGE=postgres:14-alpine
PG_PORT=5432
PG_DATABASE=tsp_dev
PG_USER=tsp
PG_PASSWORD=123456
PG_VOLUME=tsp-pgdata

# ===== 用户状态分布式存储（DES-006）=====
# PG 为持久权威，Redis 承载会话/任务热态/版本号；宿主机仅保留 logs 与 shared。
USER_STATE_PG_URL=postgresql://tsp:123456@localhost:5432/tsp_dev
USER_STATE_PG_URL_CONTAINER=postgresql://tsp:123456@host.docker.internal:5432/tsp_dev
USER_STATE_PG_SCHEMA=tsp_user_state
USER_STATE_REDIS_URL=redis://:123456@localhost:6379/3
USER_STATE_REDIS_URL_CONTAINER=redis://:123456@host.docker.internal:6379/3
USER_STATE_REDIS_PREFIX=tsp:user:
SHARED_DATA_ROOT=./data/shared
RUNTIME_DATA_ROOT=./data/.runtime
USER_BLOB_MAX_BYTES=67108864
JOB_LIVE_TTL_DAYS=7
USER_STATE_ENCRYPTION_KEY=
MINING_ARTIFACT_STORE=pgblob

# ===== Data =====
# 源码运行按项目根目录解析；Docker 相对路径按 /app 解析。
# Docker 推荐显式设置 DATA_DIR=/app/data，并把宿主机目录挂载到同一路径。
DATA_DIR=./data
